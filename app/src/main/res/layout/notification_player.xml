<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:id="@+id/notification_layout"
    android:background="#0A0F1D">

    <!-- 1. Full-bleed Album Art Background -->
    <ImageView
        android:id="@+id/notification_album_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_wassouf_fallback" />

    <!-- 2. Dark Overlay with Premium Transparency to make text and controls pop -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000" />

    <!-- 3. Symmetrical Favorite ❤️ Button on the FAR LEFT -->
    <ImageButton
        android:id="@+id/notification_favorite"
        android:layout_width="42dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_heart_outlined"
        android:scaleType="fitCenter"
        android:padding="11dp"
        android:alpha="0.85"
        android:contentDescription="Favorite" />

    <!-- 4. Symmetrical Close ✖️ Button on the FAR RIGHT -->
    <ImageButton
        android:id="@+id/notification_close"
        android:layout_width="42dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close_white"
        android:scaleType="fitCenter"
        android:padding="13dp"
        android:alpha="0.85"
        android:contentDescription="Close" />

    <!-- 5. Centered Modern Content Stack (Metadata Text + Playback Controls) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/notification_favorite"
        android:layout_toStartOf="@id/notification_close"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Header: Centered title and artist -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/notification_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم الأغنية"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notification_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جورج وسوف"
                android:textColor="#CCCCCC"
                android:textSize="9.5sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- Controls Row -->
        <LinearLayout
            android:id="@+id/notification_controls_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- Previous ⏮️ button -->
            <ImageButton
                android:id="@+id/notification_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_prev_white"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:alpha="0.9" />

            <!-- Play/Pause ▶️/⏸️ button (largest button centered) -->
            <ImageButton
                android:id="@+id/notification_play_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play_white"
                android:scaleType="fitCenter"
                android:padding="6dp" />

            <!-- Next ⏭️ button -->
            <ImageButton
                android:id="@+id/notification_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next_white"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:alpha="0.9" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>

